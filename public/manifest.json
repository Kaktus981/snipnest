{
  "manifest_version": 3,
  "name": "文栈 SnipNest",
  "description": "在你授权的网站中自动保存普通输入，并把常用文字存到浏览器本地，随时插入。",
  "version": "0.2.5",
  "minimum_edge_version": "114",
  "permissions": ["storage", "sidePanel", "scripting", "alarms", "tabs"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  },
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "文栈 SnipNest",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
